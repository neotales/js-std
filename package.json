{
  "name": "@neotales/js-workspace",
  "private": true,
  "description": "Cross-runtime TypeScript libraries, grouped by area",
  "workspaces": [
    "std/npm/*",
    "crypto/npm/*",
    "os/npm/*"
  ],
  "scripts": {
    "groups": "deno task groups",
    "build": "deno task build",
    "test": "deno task test",
    "test:all": "deno task test:all",
    "test:e2e": "deno task test:e2e",
    "test:workers": "deno task test:workers",
    "lint": "deno task lint",
    "fmt": "deno task fmt",
    "fmt:check": "deno task fmt:check",
    "audit": "deno task audit",
    "check": "deno task check",
    "pack": "deno task pack",
    "release:prepare": "deno task release:prepare",
    "publish:bootstrap": "deno task publish:bootstrap",
    "publish:dry-run": "deno task publish:dry-run",
    "publish": "deno task publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.46.0",
    "playwright": "^1.62.1",
    "wrangler": "^4.132.0"
