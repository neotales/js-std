{
  "name": "@neotales/js-std-workspace",
  "private": true,
  "workspaces": [
    "npm/*"
  ],
  "scripts": {
    "build": "deno task build",
    "test": "deno task test",
    "test:e2e": "deno task test:e2e",
    "test:workers": "node --test ./e2e/*.workerd.mjs",
    "runtime-lab:setup": "deno task runtime-lab:setup",
    "test:runtime-lab": "deno task test:runtime-lab",
    "lint": "deno task lint",
    "fmt": "deno task fmt",
    "fmt:check": "deno task fmt:check",
    "audit": "deno task audit",
    "check": "deno task check",
    "pack": "deno task pack",
    "release:prepare": "deno task release:prepare",
    "publish:bootstrap": "deno task publish:bootstrap",
    "publish:dry-run": "deno task publish:dry-run",
    "publish": "deno task publish"
  },
  "devDependencies": {
    "@neotales/ansi": "workspace:*",
    "@neotales/args": "workspace:*",
    "@neotales/chars": "workspace:*",
    "@neotales/dotenv": "workspace:*",
    "@neotales/env": "workspace:*",
    "@neotales/exec": "workspace:*",
    "@neotales/fmt": "workspace:*",
    "@neotales/fs": "workspace:*",
    "@neotales/path": "workspace:*",
    "@neotales/process": "workspace:*",
    "@neotales/results": "workspace:*",
    "@neotales/secrets": "workspace:*",
    "@neotales/slices": "workspace:*",
    "@neotales/strings": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "oxlint": "^1.46.0",
    "playwright": "^1.62.1",
    "wrangler": "^4.132.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0"
}
