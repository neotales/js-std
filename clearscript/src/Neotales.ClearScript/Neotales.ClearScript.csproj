<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Neotales.ClearScript</RootNamespace>
    <AssemblyName>Neotales.ClearScript</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Neotales.ClearScript</PackageId>
    <Description>
      A .NET compatibility layer that runs Neotales TypeScript and JavaScript modules, including
      js-os, on ClearScript's V8 engine. It injects process, environment, filesystem, console,
      encoding, and crypto primitives and awaits promises returned by scripts.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/neotales-shim.js" LogicalName="Neotales.ClearScript.Resources.neotales-shim.js" />
  </ItemGroup>

</Project>
